# Cloudflare Pages Headers Configuration

# Default for all HTML and API routes - never cache HTML to prevent stale chunk errors
/*
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  X-Content-Type-Options: nosniff

# Hashed static assets (JS, CSS, images) - cache for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service Workers and Web Manifest - never cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

